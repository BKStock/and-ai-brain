# ========================================
# 認証チェック
# ========================================
PROJECT_GROUP_ID = -1003799035163  # &AIプロジェクト管理グループ

def is_authorized(update: Update) -> bool:
    # Direct ChatのKK本人 OR プロジェクト管理グループからのKK
    user_ok = update.effective_user.id == OWNER_ID
    if user_ok:
        return True
    # グループからの場合もKKなら許可
    chat = update.effective_chat
    if chat and chat.id == PROJECT_GROUP_ID and update.effective_user.id == OWNER_ID:
        return True
    return False


